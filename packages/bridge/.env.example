# Company-side settings for the bridge. Keep this file on the company's server only.

# Where people and Meta reach this bridge (the company's own domain, HTTPS).
BRIDGE_PUBLIC_URL=https://atende.suaempresa.com.br

# The company's Bipe account (verified CNPJ, ADR 0042).
BIPE_HOMESERVER_URL=https://matrix.bipe.net.br
BIPE_USER_ID=@xxxxxxxx:bipe.net.br
BIPE_PASSWORD=
BIPE_HANDLE=suaempresa
BIPE_API_URL=https://api.bipe.net.br
# From `node dist/src/cli.js setup`, shown once. Unlocks cross-signing and key backup.
BIPE_RECOVERY_KEY=

# Tokens your own systems use on the Cloud API paths (comma-separated).
BRIDGE_API_TOKENS=
# The phone-number-id that means "send on Bipe" on the Cloud API paths.
BIPE_PHONE_NUMBER_ID=bipe

# WhatsApp Cloud API (optional). Point Meta's webhook at https://<BRIDGE_PUBLIC_URL>/webhooks/whatsapp
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v23.0

# Your own system's webhook (optional): inbound messages in the Cloud API webhook shape, signed with X-Hub-Signature-256.
BRIDGE_WEBHOOK_URL=
BRIDGE_WEBHOOK_SECRET=
