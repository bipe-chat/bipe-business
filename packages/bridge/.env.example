# Company-side settings for the bridge. Keep this file on the company's server only.

# Where agents reach this bridge (the company's own domain, HTTPS).
BRIDGE_PUBLIC_URL=https://atende.suaempresa.com.br

# The company's Bipe account (verified CNPJ, ADR 0042).
BIPE_HOMESERVER_URL=https://matrix.bipe.net.br
BIPE_USER_ID=@xxxxxxxx:bipe.net.br
BIPE_PASSWORD=
BIPE_HANDLE=suaempresa
BIPE_API_URL=https://api.bipe.net.br
# From `node dist/src/cli.js setup`, shown once. Unlocks cross-signing and key backup.
BIPE_RECOVERY_KEY=

# Tokens your own systems use on POST /v1/messages and on MCP (comma-separated).
# token:scope1+scope2 gives a token its scopes. A token with no scopes can only send (content:send).
# Scopes: conversations:read conversations:write content:read content:send content:notes
BRIDGE_API_TOKENS=

# MCP for AI assistants (README, "MCP"). off (default), local or remote. Choose local.
BRIDGE_MCP=off
# local: the MCP port on 127.0.0.1.
BRIDGE_MCP_PORT=8081
# `node dist/src/cli.js mcp` (stdio): the token the assistant uses. One of BRIDGE_API_TOKENS.
BRIDGE_MCP_TOKEN=

# Your own system's webhook (optional): inbound events, signed with the Bipe-Signature header.
BRIDGE_WEBHOOK_URL=
BRIDGE_WEBHOOK_SECRET=
